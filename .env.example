APP_ENV=dev
DATABASE_URL=sqlite:///data/weatherbot.db
DEFAULT_TIMEZONE=Europe/Stockholm
DAILY_DIGEST_HOUR=7
DAILY_DIGEST_MINUTE=30
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ALLOWED_USER_ID=
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
SMHI_METOBS_BASE_URL=https://opendata-download-metobs.smhi.se
SMHI_METFCST_BASE_URL=https://opendata-download-metfcst.smhi.se
WEATHER_PROVIDER_DEFAULT=openmeteo
WEATHER_PROVIDER_SWEDEN=smhi
OPENMETEO_BASE_URL=https://api.open-meteo.com
OPENMETEO_GEO_BASE_URL=https://geocoding-api.open-meteo.com
HISTORY_WARMUP_YEARS=30
HISTORY_WARMUP_BATCH_SIZE=20
